{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Screenshot Studio",
  "version": "0.2.1",
  "identifier": "app.screenshotstudio.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5199",
    "beforeDevCommand": "pnpm dev --port 5199 --strictPort",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Screenshot Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 16, "y": 20 },
        "hiddenTitle": true,
        "windowEffects": { "effects": ["sidebar"], "state": "followsWindowActiveState" }
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage", "deb", "nsis"],
    "createUpdaterArtifacts": true,
    "macOS": { "signingIdentity": "-" },
    "fileAssociations": [
      { "ext": ["ssproj"], "name": "Screenshot Studio project", "description": "Screenshot Studio project", "role": "Editor", "mimeType": "application/json" }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBMzgzNUY1M0RGQjkxNDgKUldSSWtmczk5VFU0aWt0d2J1S1BYSDJlYWxTVmxFYnNMZWh2UUt2VlpicXJuMC90QjA1Wkp1angK",
      "endpoints": ["https://github.com/BennoCrafter/screenshot-studio/releases/latest/download/latest.json"]
    }
  }
}
